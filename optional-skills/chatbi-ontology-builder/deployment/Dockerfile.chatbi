ARG HERMES_BASE_IMAGE=hermes-agent:base
FROM ${HERMES_BASE_IMAGE}
USER root
COPY deployment/requirements.txt /opt/chatbi-ontology-requirements.txt
RUN uv venv --python /opt/hermes/.venv/bin/python /opt/chatbi-ontology && \
    uv pip install --python /opt/chatbi-ontology/bin/python -r /opt/chatbi-ontology-requirements.txt && \
    /opt/chatbi-ontology/bin/python -c "import rdflib, pyshacl, pymysql, psycopg, sqlglot, docx, openpyxl, pptx, fitz"
# Do not replace Hermes' PATH, USER/entrypoint or HERMES_HOME. Scripts use the
# absolute interpreter /opt/chatbi-ontology/bin/python. Mount the skill separately.
